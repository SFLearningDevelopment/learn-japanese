<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Japanese Pronunciation Practice</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);min-height:100vh;padding:20px}.container{max-width:900px;margin:0 auto;background:#fff;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.2);overflow:hidden}.header{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:#fff;padding:30px;text-align:center}.header h1{font-size:2.5em;margin-bottom:10px}.header p{font-size:1.1em;opacity:.9}.content{padding:40px}.word-card{background:#f8f9fa;border-radius:15px;padding:25px;margin-bottom:20px;border-left:5px solid #667eea;transition:transform .3s,box-shadow .3s;cursor:pointer}.word-card:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(0,0,0,.1)}.word-card.playing{background:#e3f2fd;border-left-color:#1976d2}.word-header{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.word-content{flex:1;min-width:250px}.number{display:inline-block;background:#667eea;color:#fff;width:35px;height:35px;border-radius:50%;text-align:center;line-height:35px;font-weight:700;margin-bottom:10px}.english{font-size:1.3em;color:#333;font-weight:600;margin-bottom:8px}.japanese-text{font-size:2em;color:#667eea;font-weight:700;margin-bottom:5px}.romanji{font-size:1.1em;color:#666;font-style:italic}.listen-btn{background:linear-gradient(45deg,#667eea,#764ba2);color:#fff;border:none;padding:15px 30px;border-radius:25px;font-size:18px;cursor:pointer;transition:transform .2s,box-shadow .2s;display:flex;align-items:center;gap:10px;white-space:nowrap}.listen-btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(102,126,234,.4)}.listen-btn.playing{background:linear-gradient(45deg,#1976d2,#0d47a1);animation:pulse 1.5s infinite}@keyframes pulse{0%,100%{